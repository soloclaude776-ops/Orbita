<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Subir juego · Órbita</title>
<link rel="icon" type="image/svg+xml" href="/logos/orbita.svg">
<meta name="robots" content="noindex">
<style>
:root{--bg:#07080d;--bg2:#10121b;--card:#151826;--line:rgba(255,255,255,.1);--fg:#f2f3f8;--dim:#9aa0b8;--acc:#ff7a33;--ok:#5fd38d;--bad:#ff6b6b;--warn:#ffb547}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#07080d}}
:root[data-theme="dark"]{--bg:#07080d}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.top{display:flex;align-items:center;max-width:760px;margin:0 auto;padding:18px 16px}
.top a{display:flex;align-items:center;color:inherit;text-decoration:none;font-weight:900;letter-spacing:.2em}
.top img{width:36px;height:36px;margin-right:10px}
.top small{margin-left:auto;color:var(--dim)}
.box{max-width:760px;margin:0 auto 40px;padding:24px;background:var(--card);border:1px solid var(--line);border-radius:18px}
.page-pad{padding:0 16px}
h1{margin:0 0 4px;font-size:24px}
.lead{color:var(--dim);margin:0 0 20px}
label{display:block;font-size:13px;color:var(--dim);margin:16px 0 6px;font-weight:600}
input[type=text],input[type=password],textarea{width:100%;background:var(--bg2);border:1px solid var(--line);border-radius:10px;color:var(--fg);font:inherit;padding:11px 12px;outline:none}
input:focus,textarea:focus{border-color:var(--acc)}
textarea{min-height:150px;font-family:ui-monospace,Consolas,monospace;font-size:12.5px}
.row{display:flex;flex-wrap:wrap;margin:0 -6px}.row>div{flex:1 1 220px;margin:0 6px}
.btn{background:var(--acc);color:#1b0c05;border:0;border-radius:10px;padding:12px 22px;font:inherit;font-weight:800;cursor:pointer;margin-top:20px}
.btn:disabled{opacity:.5;cursor:default}
.chips button{background:var(--bg2);border:1px solid var(--line);color:var(--dim);border-radius:999px;padding:6px 12px;margin:0 6px 6px 0;font:inherit;font-size:13px;cursor:pointer}
.chips button.on{background:var(--fg);color:var(--bg)}
.drop{border:2px dashed var(--line);border-radius:12px;padding:18px;text-align:center;color:var(--dim);cursor:pointer}
.drop.has{border-color:var(--ok);color:var(--fg)}
.or{text-align:center;color:var(--dim);font-size:12px;margin:10px 0}
.msg{margin-top:16px;padding:12px 14px;border-radius:10px;display:none}
.msg.ok{display:block;background:rgba(95,211,141,.12);border:1px solid rgba(95,211,141,.4)}
.msg.bad{display:block;background:rgba(255,107,107,.12);border:1px solid rgba(255,107,107,.4)}
.msg.warn{display:block;background:rgba(255,181,71,.12);border:1px solid rgba(255,181,71,.4)}
.msg a{color:var(--acc);font-weight:700}
.hint{font-size:12px;color:var(--dim);margin-top:6px}
#prev{width:100%;max-width:320px;border-radius:10px;margin-top:8px;display:none}
.hide{display:none}
</style>
</head>
<body>
<div class="top"><a href="/"><img src="/logos/orbita.svg" alt="">ÓRBITA</a><small>Subir un juego</small></div>
<div class="page-pad">
<div class="box" id="login">
  <h1>Entrar</h1>
  <p class="lead">Solo para los creadores de Órbita.</p>
  <label for="clave">Contraseña</label>
  <input type="password" id="clave" autocomplete="current-password">
  <button class="btn" id="entrar">Entrar</button>
  <div class="msg" id="m1"></div>
</div>
<div class="box hide" id="form">
  <h1>Subir un juego nuevo</h1>
  <p class="lead">Cargá el código del juego (un archivo .html) y completá cómo se va a ver en la plataforma. Si ya existe un juego con esa dirección, se reemplaza por el nuevo.</p>
  <div class="row">
    <div><label for="titulo">Nombre del juego</label><input type="text" id="titulo" maxlength="40" placeholder="Ej: Ladrón de la noche"></div>
    <div><label for="slug">Dirección</label><input type="text" id="slug" maxlength="20" placeholder="ladron"><div class="hint" id="urlh">Se va a jugar en /…</div></div>
  </div>
  <label for="sub">Frase corta</label><input type="text" id="sub" maxlength="60" placeholder="Ej: Robos de noche, sin que te vean">
  <label for="desc">Descripción</label><textarea id="desc" maxlength="300" style="min-height:80px;font-family:inherit;font-size:14px" placeholder="De qué se trata y qué hace especial al juego"></textarea>
  <label>Tipo</label>
  <div class="chips" id="motor"><button data-v="3d" class="on">3D</button><button data-v="2d">2D</button></div>
  <label>Etiquetas</label>
  <div class="chips" id="tags"></div>
  <label>Código del juego</label>
  <div class="drop" id="drop">Tocá acá para elegir el archivo .html (o arrastralo)</div>
  <input type="file" id="file" accept=".html,.htm,text/html" class="hide">
  <div class="or">o pegá el código acá</div>
  <textarea id="code" placeholder="<!doctype html> …"></textarea>
  <label>Portada (opcional)</label>
  <input type="file" id="img" accept="image/*">
  <img id="prev" alt="">
  <button class="btn" id="subir">Subir a Órbita</button>
  <div class="msg" id="m2"></div>
</div>
</div>
<script>
(function () {
  var clave = '', motor = '3d', html = '', portada = null, gh = false;
  var TAGS = ['Acción', 'Aventura', 'Construcción', 'Multijugador', 'Supervivencia', 'Puzle', 'Estrategia', 'Carreras', 'Deportes', 'Sigilo', 'Exploración', 'IA'];
  var tags = [];
  var $ = function (id) { return document.getElementById(id); };
  function msg(el, cls, h) { el.className = 'msg ' + cls; el.innerHTML = h; }
  function post(url, body) { return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).then(function (r) { return r.json().then(function (j) { j._code = r.status; return j; }); }); }
  function entrar() {
    clave = $('clave').value; if (!clave) return;
    $('entrar').disabled = true;
    post('/api/entrar', { clave: clave }).then(function (j) {
      $('entrar').disabled = false;
      if (!j.ok) return msg($('m1'), 'bad', j.error || 'No se pudo entrar.');
      gh = j.guardaEnGithub; $('login').classList.add('hide'); $('form').classList.remove('hide');
      if (!gh) msg($('m2'), 'warn', 'Ojo: todavía no está conectado GitHub, así que los juegos que subas se borran cuando el servidor se reinicia.');
    }).catch(function () { $('entrar').disabled = false; msg($('m1'), 'bad', 'Sin conexión con el servidor.'); });
  }
  $('entrar').onclick = entrar;
  $('clave').onkeydown = function (e) { if (e.key === 'Enter') entrar(); };
  function slugify(s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '').slice(0, 20); }
  var slugTocado = false;
  $('titulo').oninput = function () { if (!slugTocado) $('slug').value = slugify(this.value); urlh(); };
  $('slug').oninput = function () { slugTocado = true; this.value = slugify(this.value); urlh(); };
  function urlh() { $('urlh').textContent = 'Se va a jugar en ' + location.host + '/' + ($('slug').value || '…'); }
  $('motor').onclick = function (e) { var b = e.target.closest('button'); if (!b) return; motor = b.getAttribute('data-v'); [].forEach.call(this.children, function (x) { x.className = x === b ? 'on' : ''; }); };
  $('tags').innerHTML = TAGS.map(function (t) { return '<button data-t="' + t + '">' + t + '</button>'; }).join('');
  $('tags').onclick = function (e) { var b = e.target.closest('button'); if (!b) return; var t = b.getAttribute('data-t'), i = tags.indexOf(t); if (i >= 0) tags.splice(i, 1); else if (tags.length < 5) tags.push(t); b.className = tags.indexOf(t) >= 0 ? 'on' : ''; };
  function leer(f) { if (!f) return; var r = new FileReader(); r.onload = function () { html = r.result; $('drop').className = 'drop has'; $('drop').textContent = 'Listo: ' + f.name + ' (' + Math.round(f.size / 1024) + ' KB)'; if (!$('titulo').value) { var m = /<title>([^<]*)/i.exec(html); if (m) { $('titulo').value = m[1].trim(); $('titulo').oninput(); } } }; r.readAsText(f); }
  $('drop').onclick = function () { $('file').click(); };
  $('file').onchange = function () { leer(this.files[0]); };
  $('drop').ondragover = function (e) { e.preventDefault(); };
  $('drop').ondrop = function (e) { e.preventDefault(); leer(e.dataTransfer.files[0]); };
  // la portada se achica a 800 px antes de mandarla
  $('img').onchange = function () {
    var f = this.files[0]; if (!f) return; var im = new Image();
    im.onload = function () { var s = Math.min(1, 800 / im.width), c = document.createElement('canvas'); c.width = Math.round(im.width * s); c.height = Math.round(im.height * s); c.getContext('2d').drawImage(im, 0, 0, c.width, c.height); portada = c.toDataURL('image/jpeg', 0.82); $('prev').src = portada; $('prev').style.display = 'block'; };
    im.src = URL.createObjectURL(f);
  };
  $('subir').onclick = function () {
    var code = html || $('code').value;
    if (!$('slug').value || $('slug').value.length < 2) return msg($('m2'), 'bad', 'Poné un nombre y una dirección (mínimo 2 letras).');
    if (!code || code.length < 50) return msg($('m2'), 'bad', 'Falta el código del juego.');
    $('subir').disabled = true; msg($('m2'), 'warn', 'Subiendo…');
    post('/api/subir', { clave: clave, id: $('slug').value, titulo: $('titulo').value, sub: $('sub').value, desc: $('desc').value, tags: tags, motor: motor, html: code, portada: portada })
      .then(function (j) {
        $('subir').disabled = false;
        if (!j.ok) return msg($('m2'), 'bad', j.error || 'No se pudo subir.');
        msg($('m2'), j.permanente ? 'ok' : 'warn', '¡Subido! Ya se juega en <a href="' + j.url + '" target="_blank">' + location.host + j.url + '</a> y aparece en la <a href="/">plataforma</a>.' + (j.permanente ? ' Quedó guardado para siempre.' : '<br>' + j.aviso));
      }).catch(function () { $('subir').disabled = false; msg($('m2'), 'bad', 'Se cortó la conexión. Probá de nuevo.'); });
  };
})();
</script>
</body>
</html>
